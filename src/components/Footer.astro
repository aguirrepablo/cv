---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <span>© {year} {site.name}</span>
  <span class="mono">Sitio estático. Sin dependencias externas.</span>
</footer>

<style>
  .site-footer {
    padding: 1.6rem 0 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    justify-content: space-between;
    font-size: .84rem;
    color: var(--ink-soft);
  }
</style>
